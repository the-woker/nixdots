{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "mpris"
    ],
    "modules-center": ["ext/workspaces"],
    "modules-right": [
        "clock", 
        "wireplumber", 
        "custom/layout", 
        "cpu", 
        "memory",
        "custom/reload", 
        "custom/power"
    ],

    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "all-outputs": false,
        "ignore-hidden": false,
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "max-length": 40,
        "player-icons": {
            "default": "▶ ",
            "spotify": " ",
            "firefox": " "
        },
        "status-icons": {
            "paused": "⏸ "
        }
    },

    "clock": {
        "timezone": "America/Vancouver",
        "format": "⏲ {:%H:%M}",
    },

    "wireplumber": {
        "format": "{volume}% 󰕾",
        "format-muted": "󰖁",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "cpu": {
        "format": " {usage}%"
    },

    "memory": {
        "interval": 10,
        "format": " {used}GiB",
        "tooltip-format": "Total: {total}GiB\nAvailable: {avail}GiB\nSwap Used: {swapUsed}GiB"
    },

    "custom/reload": {
        "format": "↻",
        "on-click": "pkill waybar && waybar &"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "poweroff"
    }
}
